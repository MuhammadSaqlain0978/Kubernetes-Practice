          },
          "containers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "image": {
                  "type": "string"
                },
                "imagePullPolicy": {
                  "enum": [
                    "",
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
