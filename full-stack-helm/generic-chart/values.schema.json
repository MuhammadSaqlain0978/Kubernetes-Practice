              "maxReplicas": {
                "type": "integer",
                "minimum": 1
              },
              "targetCPUUtilizationPercentage": {
                "type": "integer",
                "minimum": 1
              },
              "targetMemoryUtilizationPercentage": {
                "type": "integer",
                "minimum": 1
              },
              "behavior": {
                "type": "object"
              }
            }
