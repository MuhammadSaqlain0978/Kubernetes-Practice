          "revisionHistoryLimit": {
            "type": "integer",
            "minimum": 0
          },
          "strategy": {
            "type": "object"
          },
          "persistence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "size": {
                "type": "string"
              },
              "mountPath": {
                "type": "string"
              },
              "storageClass": {
                "type": "string"
              },
              "accessMode": {
                "enum": [
                  "ReadWriteOnce",
                  "ReadOnlyMany",
                  "ReadWriteMany",
                  "ReadWriteOncePod"
