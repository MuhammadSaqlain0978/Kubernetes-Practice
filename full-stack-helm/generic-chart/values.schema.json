            "type": "integer",
            "minimum": 0
          },
          "ttlSecondsAfterFinished": {
            "type": "integer",
            "minimum": 0
          },
          "restartPolicy": {
            "enum": [
              "Never",
              "OnFailure"
            ]
          },
          "hook": {
            "type": "string",
            "pattern": "^(pre|post)-(install|upgrade|delete|rollback)(,(pre|post)-(install|upgrade|delete|rollback))*$"
