    "persistentVolumeClaims": {
      "type": "object",
      "description": "persistentVolumeClaims.<key> \u2192 PVC",
      "propertyNames": {
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
